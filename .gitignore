# ignore all .a files
*.code-workspace
*.tsv.gz
*.DS_Store
*.pyc
*.pkl
*.pickle
*.hdf5
*.jsonl
*.json
*.csv
*.tsv
*.db
*.sqlite3
*.log
*.parquet
*.DS_Store
__pycache__

# vs code
.vscode/

#exclude data
/data/

# explde api key
/src/data/*.json

# --- DNF pipeline -------------------------------------------------------
# Data is regenerated by `python -m src.data.generate_dataset`, never
# committed.  The FastF1 telemetry cache alone runs to several GB.
/Data/
/data/
Data/raw/fastf1_cache/
*.ff1pkl

# Keep the generated documentation, which is small and worth reviewing in diffs.
!References/*.md

# Keep the model performance log.  It is a few kilobytes and the entire point
# is to be able to read drift out of the diff, one race at a time.
!Reports/model_log.csv
!Reports/predictions.csv

# The fitted model and its manifest are rebuilt in a quarter of a second from
# the dataset, so they are artefacts rather than source.  Only the current pair
# exists; Reports/model_log.csv is the durable record of what each one scored.
Models/*.joblib
Models/*.json

# Local virtualenv for the DNF pipeline (see requirements.txt).
.venv/
venv/
